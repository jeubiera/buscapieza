# ============================================
# BUSCATODO RD - VARIABLES DE ENTORNO
# ============================================
# Copia este archivo como .env y rellena con tus credenciales reales
# NUNCA subas el archivo .env a git

# ============================================
# SEGURIDAD
# ============================================
# Clave secreta para Flask (genera una aleatoria con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres

# Admin inicial: solo se usa la primera vez (si no existe ningún admin en la BD).
# Si dejas ADMIN_PASSWORD vacío se genera una aleatoria y se muestra en consola UNA vez.
ADMIN_EMAIL=admin@buscatodo.com.do
ADMIN_PASSWORD=

# URL pública (se usa en los enlaces de WhatsApp y Push). En producción debe ser https://
APP_URL=http://127.0.0.1:5050

# ============================================
# BASE DE DATOS
# ============================================
# PostgreSQL. Formato: postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_db
# (también se acepta "postgres://..." tal como lo entregan Render, Railway, Neon, Supabase...)
# Si la contraseña tiene caracteres especiales (@ : / #), codifícalos: @ → %40, : → %3A
DATABASE_URL=postgresql+psycopg2://buscapieza:cambia-esta-clave@localhost:5432/buscapieza

# Solo para Docker (docker-compose.yml crea la BD con esta contraseña)
# POSTGRES_PASSWORD=cambia-esta-clave

# Opcional: correr los tests contra PostgreSQL (BD vacía y desechable, se borra en cada test)
# TEST_DATABASE_URL=postgresql+psycopg2://buscapieza:cambia-esta-clave@localhost:5432/buscapieza_test

# Las tablas se crean con migraciones: flask db upgrade && flask seed (iniciar.bat lo hace solo)

# ============================================
# CLOUDINARY (Almacenamiento de Imágenes)
# ============================================
# Obtén tus credenciales en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ============================================
# GREEN API (WhatsApp Business)
# ============================================
# Obtén tus credenciales en: https://green-api.com/
# Plan gratuito: 300 mensajes/día
GREEN_API_INSTANCE=tu-instance-id
GREEN_API_TOKEN=tu-token

# ============================================
# FIREBASE CLOUD MESSAGING (Notificaciones Push)
# ============================================
# 1. Ve a Firebase Console: https://console.firebase.google.com
# 2. Selecciona tu proyecto
# 3. Click en el ícono de engranaje (⚙️) → Project Settings
# 4. Ve a la pestaña "Service accounts"
# 5. Click en "Generate new private key"
# 6. Descarga el archivo JSON y guárdalo en tu proyecto (ej: firebase-credentials.json)
# 7. IMPORTANTE: Añade el archivo JSON al .gitignore para NO subirlo a git
# 8. Coloca aquí la ruta al JSON (relativa a la carpeta del proyecto o absoluta)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Para que los navegadores puedan suscribirse (ver FIREBASE_SETUP.md):
#   Project Settings → General → tu app web → objeto firebaseConfig en una sola línea
FIREBASE_WEB_CONFIG=
#   Cloud Messaging → Web Push certificates → clave pública
FIREBASE_VAPID_PUBLIC=

# ============================================
# CONFIGURACIÓN DEL BROKER
# ============================================
# Número de WhatsApp del broker (con código de país, sin + ni espacios)
BROKER_WHATSAPP=18091234567
# Nombre del negocio
BROKER_NOMBRE=BuscatodoRD

# ============================================
# CONFIGURACIÓN DE SERVIDOR (OPCIONAL)
# ============================================
# Puerto para Flask (por defecto: 5050)
# FLASK_PORT=5050
# Modo debug (True para desarrollo, False para producción)
# FLASK_DEBUG=True
# Host (0.0.0.0 para permitir conexiones externas)
# FLASK_HOST=127.0.0.1
